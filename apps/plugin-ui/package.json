{
  "name": "@visual-team/plugin-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --format=esm --jsx=automatic --outfile=dist/visual-team.js --minify",
    "dev": "esbuild src/main.tsx --bundle --format=esm --jsx=automatic --outfile=dist/visual-team.js --watch",
