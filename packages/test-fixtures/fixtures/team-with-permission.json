{
  "name": "team-with-permission",
  "description": "A team task where a specialist joins via SubagentStart and a native permission request puts the task into needs-user state without touching the approval flow.",
  "steps": [
    {
      "kind": "start",
      "input": {
        "title": "Improve onboarding and check nothing broke",
        "summary": "Research options, implement the chosen approach, verify.",
        "mode": "team",
        "workerRoles": ["lead", "explorer"],
        "privacyMode": "standard"
      }
    },
    {
      "kind": "codex_event",
      "event": {
        "eventId": "evt-102",
        "name": "UserPromptSubmit",
        "at": "2026-09-13T16:00:00.000Z",
        "payload": { "session_id": "sess-2", "turn_id": "turn-1" }
      }
    },
    {
      "kind": "codex_event",
      "event": {
        "eventId": "evt-103",
        "name": "SubagentStart",
        "at": "2026-09-13T16:00:08.000Z",
        "payload": { "session_id": "sess-2", "turn_id": "turn-1", "agent_id": "agent-x1", "agent_type": "review" }
      }
    },
    {
      "kind": "codex_event",
      "event": {
        "eventId": "evt-104",
        "name": "PreToolUse",
        "at": "2026-09-13T16:00:12.000Z",
        "payload": { "session_id": "sess-2", "turn_id": "turn-1", "tool_name": "shell" }
      }
    },
    {
      "kind": "codex_event",
      "event": {
        "eventId": "evt-105",
        "name": "PermissionRequest",
        "at": "2026-09-13T16:00:13.000Z",
        "payload": { "session_id": "sess-2", "turn_id": "turn-1", "tool_name": "shell" }
      }
    },
    {
      "kind": "codex_event",
      "event": {
        "eventId": "evt-106",
        "name": "SubagentStop",
        "at": "2026-09-13T16:01:00.000Z",
        "payload": { "session_id": "sess-2", "turn_id": "turn-1", "agent_id": "agent-x1" }
      }
    }
  ],
  "expect": {
    "taskState": "WAITING_FOR_USER",
    "workerStates": { "lead": "WAITING_FOR_APPROVAL", "explorer": "ASSIGNED", "agent-x1": "COMPLETED" },
    "needsUser": true,
    "eventCount": 6
  }
}
